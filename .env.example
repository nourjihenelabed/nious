# Copy to .env and fill in. .env is gitignored -- credentials never get committed.

# ---------------------------------------------------------------------------
# Which backend the engine reads from.
#   graph_json -> the AXIOM knowledge graph, read in place from its JSON export
#   neo4j      -> the live read-only AXIOM knowledge graph, over Bolt
#   csv        -> a frozen snapshot directory
#   workbook   -> a spreadsheet read through an R2RML mapping
#
# Leave this unset. Each profile declares the backend its data natively lives
# in -- axiom_poc says graph_json, b2b_industrial says csv -- and setting this
# overrides that declaration for every profile at once, which is almost never
# what you want. Set it on the command line for the one run that needs it.
# ---------------------------------------------------------------------------
# PRICING_SOURCE=graph_json

# The graph export, read in place by the graph_json backend.
# PRICING_GRAPH_JSON=../axiom_pricing_module_Knowledge-graph_PoC.json

# Where a frozen CSV snapshot lives. Defaults to the newest data/snapshot_*.
# PRICING_DATA_DIR=data/snapshot_synthetic_v1

# Where the scripts write. reports/ is not keyed by profile, so set this when
# running a second client's data or it lands on top of the first one's numbers.
# PRICING_REPORTS_DIR=reports_axiom_poc

# ---------------------------------------------------------------------------
# How much evidence a deliverable needs before it will run. Defaults live in
# pyproject.toml; the recommended values are in config.RECOMMENDED_DEPTH and
# cannot be moved from here. Anything set below the recommended value is listed
# by run_readiness.py and attached to every model fitted under it.
# ---------------------------------------------------------------------------
# PRICING_MIN_ELASTICITY=120
# PRICING_MIN_OPTIMISATION=200
# PRICING_SEGMENT_MIN_DEALS=5

# The grain elasticity and acceptance are fitted at. A thin book that abstains on
# every product may still have enough history one level up.
# PRICING_ELASTICITY_SCOPE=family
# PRICING_ACCEPTANCE_SCOPE=family

# ---------------------------------------------------------------------------
# Neo4j -- fill these in when NIOUS provides access, then set
# PRICING_SOURCE=neo4j. Nothing else in the codebase needs to change.
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# MLflow (Week 2 onward). Local file store by default -- air-gapped by design,
# no external cloud calls (Brief, MLOps requirements).
# ---------------------------------------------------------------------------
# Local SQLite backend -- a single file, no server, no external calls.
# MLflow 3.x retired the old file:./mlruns store, and the model registry
# (Week 7) requires a database backend anyway.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_EXPERIMENT_NAME=axiom-pricing-engine
